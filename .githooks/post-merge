#!/usr/bin/env bash
# Auto-ingest CSV profiles that changed during `git pull` / `git merge`.
# Enable on each machine with: git config core.hooksPath .githooks

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

changed=$(git diff --name-only ORIG_HEAD HEAD -- \
    'data/backlinks/*.csv' 'data/backlinks/*.tsv' \
    'data/keywords/*.csv'  'data/keywords/*.tsv' 2>/dev/null || true)

[ -z "$changed" ] && exit 0

existing=()
while IFS= read -r f; do
    [ -f "$f" ] && existing+=("$f")
done <<< "$changed"

[ ${#existing[@]} -eq 0 ] && exit 0

echo "[post-merge] ${#existing[@]} CSV profile(s) changed — re-ingesting..."
for f in "${existing[@]}"; do echo "  - $f"; done

if ! python cli.py ingest --files "${existing[@]}"; then
    echo "[post-merge] Ingest failed. Run 'python cli.py ingest' manually after fixing." >&2
    exit 0  # don't block the merge — Parquet will just be stale until manual re-ingest
fi
